# --- database (matches docker-compose db service) ---
DATABASE_URL=postgresql+psycopg://drinkwatch:drinkwatch@db:5432/drinkwatch

# --- public URL of this API (used in docs / links) ---
PUBLIC_BASE_URL=http://127.0.0.1:8788

# --- admin token for /v1/admin/* (generate: python -c "import secrets;print(secrets.token_urlsafe(32))") ---
ADMIN_TOKEN=change-me

# --- scraping ---
SCRAPE_ENABLED=true
SCRAPE_USER_AGENT=DrinkWatch/0.1 (price tracker; contact: you@example.com)
SCHEDULER_ENABLED=true

# --- woolworths store pin ---
# Woolworths publishes one price per state; without a store the search API
# answers from whatever context it infers and a non-WA price can end up on a
# Perth store. Set a WA store number so the scrape is pinned and its rows carry
# state=WA. Leave empty and rows stay unscoped (state null), as before.
WOOLWORTHS_STORE_ID=
WOOLWORTHS_SETTLEMENT=
WOOLWORTHS_STATE=WA

# --- api behaviour ---
CORS_ORIGINS=*
DEFAULT_RADIUS_KM=15
MAX_RADIUS_KM=100
DEFAULT_MAX_AGE_HOURS=72
MAX_PRICE_CENTS=50000

# --- photos (redmax backup disk: set PHOTOS_HOST_DIR to the mount) ---
PHOTOS_HOST_DIR=./photos
PHOTOS_DIR=/srv/photos
PHOTOS_MAX_BYTES=8388608

# --- external lookups ---
OFF_LOOKUP_ENABLED=true      # Open Food Facts suggestion fallback (thin for AU)

# --- fuel + route planning ---
FUELWATCH_ENABLED=true       # FuelWatch WA RSS feed for ULP prices
VEHICLE_L_PER_100KM=8.5
FUEL_PRICE_CENTS_PER_L=180   # fallback if FuelWatch is unreachable

# --- budget optimiser ---
MAX_BUDGET_CENTS=20000
DAILY_CAFFEINE_LIMIT_MG=400
